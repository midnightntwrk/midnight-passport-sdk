{
  "name": "@midnight-ntwrk/mn-passport-core",
  "version": "0.0.0",
  "description": "The account contract client that the Midnight Passport entry libraries share.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./chain": {
      "types": "./dist/chain.d.ts",
      "default": "./dist/chain.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "dist/chain.js",
    "dist/chain.js.map",
    "dist/**/*.d.ts"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.test.json && node ../../scripts/bundle-packages.mjs",
    "test": "node --test \"dist-test/**/*.test.js\""
  },
  "dependencies": {
    "@midnight-ntwrk/compact-js": "3.0.2",
    "@midnight-ntwrk/midnight-js": "5.0.1",
    "@midnight-ntwrk/mn-passport-contract": "workspace:*",
    "@midnight-ntwrk/mn-passport-protocol": "workspace:*",
    "@midnightntwrk/ledger-v9": "1.0.2",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0"
  }
}
