{
  "name": "midnight-passport-sdk",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json && tsc -p tsconfig.json",
    "test": "pnpm run build && node -e \"if(!fs.globSync('tests/**/*.test.mjs').length){console.error('no test files matched');process.exit(1)}\" && node --test \"tests/**/*.test.mjs\" && pnpm -r test",
    "lint": "node scripts/lint-boundaries.mjs && node scripts/check-single-copy.mjs pnpm-lock.yaml",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@midnight-ntwrk/compact-js": "3.0.2",
    "@midnight-ntwrk/compact-runtime": "0.21.0",
    "@midnight-ntwrk/midnight-js": "5.0.1",
    "@midnight-ntwrk/platform-js": "3.0.0",
    "@types/node": "22.20.5",
    "effect": "4.1.4",
    "prettier": "3.10.1",
    "typescript": "6.0.3"
  }
}
