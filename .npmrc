# Supply-chain posture (FS-0.1; docs/development-workflow.md §2 deps).
# Exact pins by default — the 7-day cooldown assumes no floating ranges.
save-exact=true
# No dependency lifecycle scripts — the dominant npm supply-chain attack
# path. Note: while this is true, pnpm's approve-builds/onlyBuiltDependencies
# hatch is inert and pending-build warnings are silenced; when a dependency
# legitimately needs a build, flip this to false AND allowlist it via
# onlyBuiltDependencies in pnpm-workspace.yaml (a deliberate, reviewed change).
ignore-scripts=true
