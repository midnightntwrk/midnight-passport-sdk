{
  "name": "@midnight-ntwrk/mn-passport-adapter-browser",
  "version": "0.0.0",
  "description": "The browser platform adapter of Midnight Passport.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./esbuild": {
      "types": "./dist/esbuild.d.ts",
      "default": "./dist/esbuild.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.test.json",
    "test": "node --test \"dist-test/**/*.test.js\""
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.21.0",
    "@midnight-ntwrk/mn-passport-core": "workspace:*",
    "@midnightntwrk/ledger-v9": "1.0.2"
  }
}
